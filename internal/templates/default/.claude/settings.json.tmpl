{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */openspec/changes/*/tasks.md) case \"$f\" in */openspec/changes/archive/*) ;; *) (cd \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\" && bash scripts/sync-issues.sh --auto >/dev/null 2>&1 &) ;; esac ;; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
